# ============================================
# Telegram Coin Scanner Bot - Configuration
# ============================================

# Your Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# The Telegram Chat ID of the group to post to
# (Use @userinfobot or @raw_data_bot to get the group chat ID)
TELEGRAM_CHAT_ID=-1001234567890

# Scan interval in seconds (how often to check for new coins)
SCAN_INTERVAL=30

# Enable/disable specific scanners (true/false)
ENABLE_DEXSCREENER=true
ENABLE_GECKOTERMINAL=true
ENABLE_PUMPFUN=true

# Optional: Filter by minimum liquidity (USD) - set to 0 to disable
MIN_LIQUIDITY=0

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
